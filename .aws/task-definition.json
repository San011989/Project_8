{
  "family": "resolveai-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::605628228051:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "resolveai-app",
      "image": "605628228051.dkr.ecr.ap-south-1.amazonaws.com/resolveai-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ]
    }
  ]
}