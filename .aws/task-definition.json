{
  "family": "resolveai-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::605628228051:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "resolveai-app",
      "image": "placeholder",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "secrets": [
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:605628228051:secret:resolveai/api-keys-wHkSJm"
        }
      ]
    }
  ]
}
